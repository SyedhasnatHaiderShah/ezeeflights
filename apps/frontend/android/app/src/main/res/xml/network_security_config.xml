<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config for EzeeFlights
  - Allows HTTPS to all domains (production)
  - Also allows HTTP to localhost for local dev server access
-->
<network-security-config>
    <!-- Trust system CA certificates for all domains (production HTTPS) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext (HTTP) only for local development -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
        <domain includeSubdomains="true">192.168.100.0</domain>
    </domain-config>
</network-security-config>
