{
  "name": "@ezeeflights/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "mobile:sync": "node scripts/mobile-sync.js",
    "mobile:patch": "node scripts/patch-capacitor-plugins.js",
    "mobile:pull": "node scripts/pull-to-mobile.js",
    "logos:download": "node scripts/download-airline-logos.js",
    "build:mobile": "npm run mobile:sync && npm run cap:assets && node scripts/patch-capacitor-plugins.js && node scripts/fix-api-routes.js && cross-env CAPACITOR_BUILD=true next build && node scripts/fix-api-routes.js --revert",
    "build:mobile:prod": "cross-env APP_ENV=production npm run build:mobile",
    "cap:sync": "node scripts/patch-capacitor-plugins.js && npm run build:mobile && npx cap sync",
    "cap:sync:prod": "cross-env APP_ENV=production npm run cap:sync",
    "cap:android": "node scripts/patch-capacitor-plugins.js && npm run build:mobile && npx cap sync android && npx cap open android",
    "cap:android:prod": "cross-env APP_ENV=production npm run cap:android",
    "cap:ios": "npm run build:mobile && npx cap sync ios && npx cap open ios",
    "cap:ios:prod": "cross-env APP_ENV=production npm run cap:ios",
    "cap:assets": "node scripts/generate-mobile-assets.js"
  },
  "dependencies": {
